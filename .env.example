# Copy file này thành .env. Không commit .env, không đưa key lên browser.
AI_PROVIDER=gemini
# Tên model thực sự khả dụng trong tài khoản; không tự nhận đã kiểm tra.
AI_MODEL=
# Key truy cập CLIProxyAPI local, gửi bằng header x-goog-api-key.
GEMINI_API_KEY=
# Đã probe local: /models=404, /v1beta/models=401 (cần key).
# Không thêm /models hoặc :generateContent vào Base URL.
AI_BASE_URL=http://localhost:8317/v1beta
# Google Gemini trực tiếp: https://generativelanguage.googleapis.com/v1beta
# OpenAI-compatible nếu cần: AI_PROVIDER=openai-compatible,
# AI_BASE_URL=http://localhost:8317/v1, AI_API_KEY=<key proxy>
# Đường dẫn từ thư mục sản phẩm hoặc đường dẫn tuyệt đối.
VLEARN_DATA_DIR=../K4-3B-Day05-06-AI-Product-Hackathon/data/vlearn-pack/transcript
# Bản thử slide/PDF: đổi thành slides; transcript để quay lại nguồn cũ.
VLEARN_SOURCE_KIND=slides
VLEARN_SLIDES_DIR=../K4-3B-Day05-06-AI-Product-Hackathon/data/vlearn-pack/slides
PORT=8765
